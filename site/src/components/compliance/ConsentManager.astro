---

<Fragment>
    <link rel="preconnect" href="//privacy-proxy.usercentrics.eu" />
    <link rel="preload" href="//privacy-proxy.usercentrics.eu/latest/uc-block.bundle.js" as="script" />
    <script is:inline type="application/javascript" src="https://privacy-proxy.usercentrics.eu/latest/uc-block.bundle.js"></script>
    <script is:inline id="usercentrics-cmp" src="https://app.usercentrics.eu/browser-ui/latest/loader.js" data-settings-id="J9SFEAPwLRN6NI" async></script>
    <script is:inline>uc.setCustomTranslations("https://termageddon.ams3.cdn.digitaloceanspaces.com/translations/");</script>
    {/* Adobe Fonts is approved as necessary (D-014, D-043). The blocker files use.typekit.net under "Adobe WebFonts" (HJy4c4s_jbX), not the banner's "Adobe Fonts" (gMYO_vhh). Without this exemption it strips the stylesheet and headings fall back to Georgia. */}
    <script is:inline>uc.deactivateBlocking(["HJy4c4s_jbX"]);</script>

    {/* Google Consent Mode v2: everything denied until the visitor chooses (consent-setup.md rule 4). Inline only; contacts no third party. */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("consent", "default", { ad_storage: "denied", analytics_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", wait_for_update: 500 });
    </script>

    {/* Trackers from tag-registry.csv. type="text/plain" keeps each one inert; Usercentrics runs it only after consent for the service named in data-usercentrics. That name must match the service in Termageddon's list exactly, or the tag stays off. */}
    <script is:inline type="text/plain" data-usercentrics="Google Analytics" src="https://www.googletagmanager.com/gtag/js?id=G-9F1FS7LQG6" async></script>
    <script is:inline type="text/plain" data-usercentrics="Google Analytics">
      gtag("consent", "update", { analytics_storage: "granted" });
      gtag("js", new Date());
      gtag("config", "G-9F1FS7LQG6");
      if (location.pathname.replace(/\.html$/, "") === "/global-thank-you-page") {
        gtag("event", "lead_submitted", { event_category: "conversion", page_location: location.href });
      }
    </script>
    <script is:inline type="text/plain" data-usercentrics="Microsoft Clarity">
      (function (c, l, a, r, i, t, y) { c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); }; t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i; y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y); })(window, document, "clarity", "script", "vvshugtnm5");
    </script>
