---
import Icon from "@/components/media/Icon.astro";
import Img from "@/components/media/Img.astro";
import logo from "@/assets/images/global/global-footer-logo.svg";
import glow from "@/assets/images/global/global-footer-glow.webp";
import { SITE_NAME, SITE_LEGAL_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const columns = [
  {
    title: "Company",
    links: [
      { href: "/", label: "Home" },
      { href: "https://www.exactmedicare.com", label: "Exact Medicare" },
      { href: "https://exactbenefitsgroup.com/", label: "Exact Benefits Group" },
      { href: "/the-employee-medicare-guide", label: "Subscribe" },
    ],
  },
  {
    title: "Medicare Resource Center",
    links: [
      { href: "/blogs", label: "The Exact Blog" },
      {
        href: "/medicare-part-a-and-b",
        label: "HOW TO: Apply for Medicare Parts A and B",
      },
      { href: "/filling-out-the-l564-form", label: "HOW TO: CMS-L564 form guide" },
      {
        href: "/creating-a-social-security-account",
        label: "HOW TO: Set up your Social Security account",
      },
      { href: "/enrolling-in-part-d", label: "HOW TO: Enroll in Medicare Part D" },
      { href: "/medicare-pricing-calculator", label: "Savings Calculator" },
    ],
  },
  {
    title: "ICHRA",
    links: [
      { href: "/ichra-strategy", label: "What is ICHRA?" },
      {
        href: "/ichra-administrators-platforms",
        label: "ICHRA for Administrators & Platforms",
      },
      { href: "/ichra-and-medicare-services", label: "ICHRA for Medicare" },
      { href: "/ichra-for-brokers-and-peos", label: "ICHRA for Brokers & PEOs" },
      {
        href: "/ichra-for-employers-and-employees",
        label: "ICHRA for Employers and Employees",
      },
    ],
  },
];

const legal = [
  { href: "/privacy-policy", label: "Privacy Policy" },
  { href: "/sms-terms-of-service", label: "SMS Terms of Service" },
];
---

{render && (
  <footer class="footer_wrap theme-dark">
    <div class="footer_inner">
      <div class="footer_top">
        <a class="footer_logo" href="/" aria-label={SITE_NAME}>
          <Icon src={logo} variant="full-width" />
        </a>
        {columns.map((column) => (
          <nav class="footer_column" aria-label={column.title}>
            <p class="footer_title text-style-large">{column.title}</p>
            <ul class="footer_links">
              {column.links.map((link) => (
                <li>
                  <a class="footer_link" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
      <div class="footer_bottom">
        <ul class="footer_legal">
          {legal.map((link) => (
            <li>
              <a class="footer_legal_link text-style-small" href={link.href}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="footer_copyright text-style-small">
          &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
          {SITE_LEGAL_NAME}. All rights reserved.
        </p>
      </div>
    </div>
    <div class="footer_glow" aria-hidden="true">
      <Img src={glow} alt="" transparent loading="lazy" />
    </div>
  </footer>
)}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      position: relative;
      display: flex;
      justify-content: center;
      padding-block: var(--section-space-small);
      padding-inline: var(--site-margin);
      background-color: var(--background-2);
      color: var(--teal-100);
      overflow: clip;
    }

    .footer_inner {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .footer_top {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-8) var(--site-gutter);
      align-items: start;
      @media (width >= 62rem) {
        grid-template-columns: 2fr 1.25fr 1fr 1fr;
      }
    }

    .footer_logo {
      display: block;
      width: 12rem;
      max-width: 100%;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_title {
      margin-bottom: var(--space-4);
      color: var(--text);
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .footer_link,
    .footer_legal_link {
      color: inherit;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--lime-500);
        }
      }
    }

    .footer_bottom {
      display: flex;
      flex-direction: column-reverse;
      gap: var(--space-4);
      padding-top: var(--space-6);
      border-top: var(--border-width) solid var(--border);
      @media (width >= 48rem) {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
    }

    .footer_legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-5);
    }

    .footer_legal_link {
      text-decoration: underline;
    }

    .footer_glow {
      position: absolute;
      inset: auto 0 0;
      pointer-events: none;
      opacity: 0.6;
    }
  }
</style>
