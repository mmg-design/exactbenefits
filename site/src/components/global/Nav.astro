---
import Icon from "@/components/media/Icon.astro";
import NavLink from "@/components/global/NavLink.astro";
import Dropdown from "@/components/interactive/Dropdown.astro";
import Button from "@/components/Button.astro";
import logo from "@/assets/images/global/global-nav-logo.svg";
import { SITE_NAME, SITE_PHONE } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;

const resources = [
  { href: "/blogs", label: "The Exact Blog + Newsletter" },
  {
    href: "/medicare-part-a-and-b",
    label: "How to Enroll in Medicare: A Step-by-Step Instruction Guide",
  },
  { href: "/filling-out-the-l564-form", label: "CMS-L564 Form Guide" },
  {
    href: "/creating-a-social-security-account",
    label: "Set Up Your Social Security Account",
  },
  { href: "/enrolling-in-part-d", label: "Medicare Part D Enrollment" },
  { href: "/medicare-pricing-calculator", label: "Medicare Savings Calculator" },
];

const ichra = [
  { href: "/ichra-strategy", label: "What is CHOICE/ICHRA?" },
  { href: "/ichra-and-medicare-services", label: "CHOICE/ICHRA Medicare Support" },
  {
    href: "/ichra-administrators-platforms",
    label: "CHOICE/ICHRA for Administrators & Platforms",
  },
  { href: "/ichra-for-brokers-and-peos", label: "CHOICE/ICHRA for Brokers & PEOs" },
  {
    href: "/ichra-for-employers-and-employees",
    label: "CHOICE/ICHRA for Employers + Employees",
  },
];

const dashboard =
  "https://ichra-provider-dashboard-a6g2g7crfxb5czga.eastus-01.azurewebsites.net/";
---

{render && (
  <header class:list={["nav_wrap", overlap && "overlap"]}>
    <div class="nav_inner">
      <a class="nav_logo" href="/" aria-label={SITE_NAME}>
        <Icon src={logo} variant="full-width" />
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav_toggle_icon" />
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label="Main">
        <div class="nav_menu_inner">
          <ul class="nav_links">
            <NavLink href="/#about">About</NavLink>
            <li>
              <Dropdown label="Medicare Resource Center" variant="responsive">
                <ul class="nav_sublinks">
                  {resources.map((link) => (
                    <NavLink href={link.href}>{link.label}</NavLink>
                  ))}
                </ul>
              </Dropdown>
            </li>
            <li>
              <Dropdown label="CHOICE/ICHRA" variant="responsive">
                <ul class="nav_sublinks">
                  {ichra.map((link) => (
                    <NavLink href={link.href}>{link.label}</NavLink>
                  ))}
                </ul>
              </Dropdown>
            </li>
            <NavLink href={dashboard}>Dashboard Login</NavLink>
          </ul>
          <div class="nav_buttons">
            <Button element="link" href={SITE_PHONE.href} emphasis="accent">
              {SITE_PHONE.label}
            </Button>
            <Button element="link" href="/#call-anchor">
              schedule my call
            </Button>
          </div>
        </div>
      </nav>
    </div>
  </header>
)}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 80rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-4);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 12rem;
      max-width: 50vw;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--background);
      border-bottom: var(--border-width) solid var(--border);
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      & > li + li {
        border-top: var(--border-width) solid var(--border);
      }
    }

    .nav_sublinks {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--text);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--teal-700);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--teal-700);
        }
      }
    }

    .nav_buttons {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-1);
      padding: 0 var(--site-margin) var(--space-6);
    }

    @media (width >= 80rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        background-color: transparent;
        border-bottom: 0;
      }

      .nav_menu_inner {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: center;
        padding: 0;
        gap: var(--space-2);
        white-space: nowrap;
        & > li + li {
          border-top: 0;
        }
      }

      .nav_sublinks .nav_link {
        padding-block: var(--space-1);
      }

      .nav_link {
        padding-block: 0;
      }

      .nav_buttons {
        flex-wrap: nowrap;
        padding: 0;
        white-space: nowrap;
      }
    }
  }
</style>
