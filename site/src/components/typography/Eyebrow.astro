---
import type { HTMLAttributes, SvgComponent } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. `tag` is the lime pill, `tag-outline` the outlined pill for dark surfaces. */
  variant?: "default" | "tag" | "tag-outline";
  /** Decorative icon before the text. */
  icon?: SvgComponent;
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  icon,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{render && content && (
  <div
    class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
    {...rest}
  >
    {variant === "default" && (
      <span class="eyebrow_marker" aria-hidden="true" />
    )}
    <Icon src={icon} render={!!icon} variant="small" />
    <Tag class="eyebrow_text text-style-small">
      <Fragment set:html={content} />
    </Tag>
  </div>
)}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &:is(.tag, .tag-outline) {
        gap: 0.5rem;
        justify-content: center;
        padding: 0.175rem 0.5rem;
        border: var(--border-width) solid var(--_tag-border);
        border-radius: var(--radius-round);
        background-color: var(--_tag-background);
        color: var(--_tag-text);

        & .eyebrow_text {
          margin: 0;
          text-box: normal;
          font-weight: var(--primary-bold);
          line-height: 1.5;
          text-transform: uppercase;
        }
        & .icon {
          --_size: 1rem;
        }
      }
      &.tag {
        --_tag-background: var(--lime-500);
        --_tag-border: var(--lime-700);
        --_tag-text: var(--dark-950);
      }
      &.tag-outline {
        --_tag-background: transparent;
        --_tag-border: var(--light-300);
        --_tag-text: var(--light-100);
      }
      .eyebrow_marker {
        flex: none;
        width: var(--border-width);
        height: 0.75rem;
        background-color: currentcolor;
      }
    }

    :is(.eyebrow_wrap.tag, .eyebrow_wrap.tag-outline) + .heading {
      margin-top: var(--space-4);
    }
  }
</style>
