---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type ContentWrapperVariant =
  | "stack"
  | "auto-width"
  | "columns"
  | "breakout"
  | "contain"
  | "sticky-content"
  | "sticky-visual"
  | "sticky-stack"
  | "card";

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Content layout. */
  variant?: ContentWrapperVariant;
};

type ColumnClasses = {
  /** First-column classes. */
  column1Class?: string;
  /** Second-column classes. */
  column2Class?: string;
};

type Props = Base &
  (
    | {
        variant?: "stack";
        reverse?: never;
        /** Center each column's content. */
        centered?: boolean;
        mediaOpacity?: never;
        cardTheme?: never;
      }
    | {
        variant: "auto-width";
        reverse?: never;
        centered?: never;
        mediaOpacity?: never;
        cardTheme?: never;
      }
    | {
        variant: "columns" | "breakout";
        /** Show the second column first. */
        reverse?: boolean;
        centered?: never;
        mediaOpacity?: never;
        cardTheme?: never;
      }
    | {
        variant: "contain";
        /** Show the second column first. */
        reverse?: boolean;
        centered?: never;
        mediaOpacity?: never;
        /** Solid card theme, using the theme's main background. */
        cardTheme?: "dark" | "light";
      }
    | {
        variant: "sticky-content" | "sticky-visual" | "sticky-stack";
        reverse?: never;
        centered?: never;
        mediaOpacity?: never;
        cardTheme?: never;
      }
    | {
        variant: "card";
        reverse?: never;
        centered?: never;
        /**
         * Card visual opacity. Defaults to `70`.
         *
         * @min 0
         * @max 100
         * @int
         */
        mediaOpacity?: number;
        /** Card color theme. Defaults to `dark`. */
        cardTheme?: "dark" | "light";
      }
  ) &
  ColumnClasses;

type AllProps = Base &
  ColumnClasses & {
    variant?: ContentWrapperVariant;
    reverse?: boolean;
    centered?: boolean;
    mediaOpacity?: number;
    cardTheme?: "dark" | "light";
  };

const {
  render = true,
  variant = "stack",
  reverse = false,
  centered = false,
  mediaOpacity,
  cardTheme,
  column1Class,
  column2Class,
  class: className,
  ...rest
} = Astro.props as AllProps;

const validMediaOpacity =
  mediaOpacity !== undefined &&
  Number.isFinite(mediaOpacity) &&
  mediaOpacity >= 0 &&
  mediaOpacity <= 100;

if (import.meta.env.DEV && mediaOpacity !== undefined) {
  if (!validMediaOpacity) {
    console.warn(
      `[lumos] <ContentWrapper mediaOpacity={${mediaOpacity}}> must be between 0 and 100; the default is used instead.`,
    );
  } else if (variant !== "card") {
    console.warn(
      `[lumos] <ContentWrapper variant="${variant}"> ignores mediaOpacity; only the card variant has a visual to fade.`,
    );
  }
}

const media =
  variant === "card" && validMediaOpacity && mediaOpacity !== 70
    ? `--_media-opacity: ${mediaOpacity}`
    : undefined;

const variantClasses =
  variant === "stack"
    ? []
    : variant === "card"
      ? ["card-layout", `theme-${cardTheme ?? "dark"}`]
      : variant === "contain" && cardTheme
        ? ["contain", "themed", `theme-${cardTheme}`]
        : [variant];

const column1 = await slotContent(Astro.slots);
const column2 = await slotContent(Astro.slots, "column2");
---

{render && (column1 || column2) && (
  <div
    class:list={[
      "layout",
      variantClasses,
      reverse && "reversed",
      centered && "centered",
      className,
    ]}
    style={media}
    {...rest}
  >
    {column1 && (
      <div class:list={[column1Class]}>
        <Fragment set:html={column1} />
      </div>
    )}
    {column2 && (
      <div class:list={[column2Class]}>
        <Fragment set:html={column2} />
      </div>
    )}
  </div>
)}

<style is:global>
  @layer components {
    .layout {
      /* layout defaults */
      --_visual-ratio: 3 / 2;
      --_alignment: start;
      --_column-count: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      column-gap: var(--site-gutter);
      row-gap: var(--space-8);
      align-items: stretch;
      grid-template-columns: repeat(var(--_column-count), minmax(0, 1fr));

      /* column defaults */
      & > * {
        display: flex;
        flex-direction: column;
        align-items: var(--_alignment, start);
        text-align: var(--_alignment, start);
        width: 100%;
        max-width: 100%;
      }
      & > :first-child {
        align-self: center;
      }

      /* visual ratio lock */
      & > :last-child:not(:has(> :not(.image, .video, .overlay))) {
        position: relative;
        border-radius: var(--radius-small);
        aspect-ratio: var(--_visual-ratio);
        & > :is(.image, .video, .overlay) {
          border-radius: inherit;
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
        }
      }

      /* variant overrides */
      &.centered {
        --_alignment: center;
      }
      &.auto-width {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: end;
        row-gap: var(--space-6);
        & > * {
          width: auto;
          align-self: unset;
        }
        & > :last-child {
          min-width: min(4rem, 100%);
        }
      }
      &.columns {
        display: grid;
        column-gap: var(--section-space-small);
        @media (width >= 62rem) {
          --_column-count: 2;
          &.reversed {
            & > :last-child {
              order: -1;
            }
          }
        }
      }
      &.sticky-content {
        --_visual-ratio: 1 / 1;
        display: grid;
        @media (width >= 62rem) {
          --_column-count: 2;
          & > :first-child {
            align-self: start;
            position: sticky;
            top: calc(var(--site-margin) + var(--nav-height));
          }
        }
      }
      &.sticky-visual {
        --_visual-ratio: 1 / 1;
        display: grid;
        @media (width >= 62rem) {
          --_column-count: 2;
          & > :first-child {
            align-self: start;
          }
          & > :last-child {
            align-self: start;
            position: sticky;
            top: calc(var(--site-margin) + var(--nav-height));
            max-height: calc(
              100svh - var(--nav-height) - var(--site-margin) * 2
            );
          }
        }
      }
      /* Second column's children slide up and pile over one another as the
         page scrolls, beside a pinned first column. Short screens scroll
         normally, so a pinned card can never hide the one under it. */
      &.sticky-stack {
        --_stack-top: 30svh;
        display: grid;
        @media (width >= 62rem) {
          --_column-count: 2;
          & > :first-child {
            align-self: start;
          }
        }
        & > :last-child > * {
          margin-bottom: var(--section-space-medium);
        }
        @media (height >= 40rem) {
          & > :last-child > * {
            position: sticky;
            top: calc(var(--_stack-top) + var(--_stack-step, 0) * 2svh);
          }
          & > :last-child > :nth-child(2) { --_stack-step: 1; }
          & > :last-child > :nth-child(3) { --_stack-step: 2; }
          & > :last-child > :nth-child(4) { --_stack-step: 3; }
          & > :last-child > :nth-child(5) { --_stack-step: 4; }
          & > :last-child > :nth-child(6) { --_stack-step: 5; }
          @media (width >= 62rem) {
            & > :first-child {
              position: sticky;
              top: var(--_stack-top);
            }
          }
        }
      }
      &.breakout {
        display: grid;
        width: 100vw;
        flex-shrink: 0;
        align-self: center;
        column-gap: 0;
        row-gap: 0;
        & > :first-child {
          margin-inline: auto;
          width: var(--site-width);
          padding-block: var(--section-space-medium);
        }
        & > :last-child {
          border-radius: 0;
        }
        @media (width >= 62rem) {
          --_column-count: 2;
          & > :first-child {
            max-width: calc(var(--max-width-main) / 2);
          }
          & > :last-child {
            border-top-left-radius: var(--radius-small);
            border-bottom-left-radius: var(--radius-small);
          }
          &.reversed {
            & > :last-child {
              order: -1;
              border-top-left-radius: 0;
              border-bottom-left-radius: 0;
              border-top-right-radius: var(--radius-small);
              border-bottom-right-radius: var(--radius-small);
            }
          }
        }
      }
      &.contain {
        display: grid;
        column-gap: 0;
        row-gap: 0;
        background-color: var(--background-2);
        border-radius: var(--radius-main);
        position: relative;
        overflow: clip;
        & > :first-child {
          padding: var(--space-6);
        }
        & > :last-child {
          border-radius: 0;
        }
        @media (width >= 62rem) {
          --_column-count: 2;
          &.reversed {
            & > :last-child {
              order: -1;
            }
          }
        }
      }
      &.contain.themed {
        background-color: var(--background);
        border: var(--border-width) solid var(--light-300);
        & > :last-child {
          justify-content: center;
          padding: var(--space-6);
        }
      }
      &.card-layout {
        border-radius: var(--radius-main);
        background-color: var(--background);
        position: relative;
        overflow: clip;
        min-height: 26rem;
        justify-content: center;
        & > :first-child {
          padding: var(--space-6);
        }
        & > :first-child {
          padding-block: var(--section-space-medium);
          padding-inline: var(--space-5);
          position: relative;
          z-index: 1;
          --_alignment: center;
        }
        & > :last-child:not(:first-child) {
          position: absolute;
          inset: 0;
          border-radius: 0;
          width: 100%;
          height: 100%;
          opacity: calc(var(--_media-opacity, 70) / 100);
          pointer-events: none;
        }
      }
    }
  }
</style>
