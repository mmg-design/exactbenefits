---
import { getCollection, render } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import ArticleLayout from "@/components/content/ArticleLayout.astro";
import ContactSection from "@/components/section/ContactSection.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<Layout fullTitle={post.data.metaTitle} description={post.data.description} type="article">
  <ArticleLayout
    tag={post.data.category}
    heading={post.data.title}
    image={post.data.mainImage}
    imageAlt={post.data.title}
    headings={headings}
    sideText={"Schedule a call with a licensed Medicare professional to discuss your needs and how we can transform your employee benefits."}
  >
    <Content />
  </ArticleLayout>
  <ContactSection />
</Layout>
