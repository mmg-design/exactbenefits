---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import Img from "@/components/media/Img.astro";
import Marquee from "@/components/interactive/Marquee.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import CarrierLogos from "@/components/section/CarrierLogos.astro";
import NewsletterSection from "@/components/section/NewsletterSection.astro";
import PartnershipsSection from "@/components/section/PartnershipsSection.astro";
import FaqSection from "@/components/section/FaqSection.astro";
import ContactSection from "@/components/section/ContactSection.astro";
import TableComparison from "@/components/content/TableComparison.astro";
import BentoWhyExact from "@/components/content/BentoWhyExact.astro";
import CalculatorSavings from "@/components/content/CalculatorSavings.astro";

import iconPiggyBank from "@/assets/icons/piggy-bank.svg";
import iconXCircle from "@/assets/icons/x-circle.svg";
import savingsAccent from "@/assets/images/home/home-savings-accent-icon.webp";
import comparisonTexture from "@/assets/images/home/home-comparison-card-background.webp";
import whyTeam from "@/assets/images/home/home-why-account-team.webp";
import whyAnalysis from "@/assets/images/home/home-why-plan-analysis.webp";
import whyWorkshops from "@/assets/images/home/home-why-workshops.webp";
import whyEnrollment from "@/assets/images/home/home-why-enrollment.webp";
import whySupport from "@/assets/images/home/home-why-ongoing-support.webp";
import iconPremium from "@/assets/images/home/home-savings-icon-premium.webp";
import iconPlanSpend from "@/assets/images/home/home-savings-icon-plan-spend.webp";
import iconBenefits from "@/assets/images/home/home-savings-icon-benefits.webp";
import teamSarah from "@/assets/images/global/global-team-sarah.webp";
import teamAshley from "@/assets/images/global/global-team-ashley.webp";
import teamRicky from "@/assets/images/global/global-team-ricky.webp";
import teamMatt from "@/assets/images/global/global-team-matt.webp";
import teamCourtney from "@/assets/images/global/global-team-courtney.webp";
import tickerAetna from "@/assets/images/home/home-ticker-aetna-logo.webp";
import tickerHumana from "@/assets/images/home/home-ticker-humana-logo.webp";
import tickerCigna from "@/assets/images/home/home-ticker-cigna-logo.webp";
import tickerWellcare from "@/assets/images/home/home-ticker-wellcare-logo.webp";
import tickerDevoted from "@/assets/images/home/home-ticker-devoted-logo.webp";
import tickerAnthem from "@/assets/images/home/home-ticker-anthem-logo.webp";
import tickerHeartland from "@/assets/images/home/home-ticker-heartland-logo.webp";

const comparison = [
  { label: "Monthly Premium", base: "$200 – $600+/month", highlight: "As low as $0/month—plans vary by location and carrier" },
  { label: "Annual Deductible", base: "$1,000 – $5,000+/year", highlight: "$0 on many plans—varies by plan and service type" },
  { label: "Out-of-Pocket Max", base: "Often $6,000 – $10,000+", highlight: "Capped by federal law—annual limit set by CMS, contact us for current year maximum" },
  { label: "Dental Coverage", base: "Separate / Very Limited", highlight: "Included in most plans" },
  { label: "Vision & Hearing", base: "Rarely included", highlight: "Included in most plans" },
  { label: "Prescription Drugs", base: "Varies widely by plan", highlight: "Part D built-in" },
  { label: "Fitness Benefits", base: "Rarely included", highlight: "SilverSneakers® & more" },
  { label: "Specialist Access", base: "Restricted to plan network", highlight: "Access to broad networks—varies by plan type (HMO vs. PPO)" },
];

const why = [
  { heading: "Direct employee support", text: "Your employees get a direct line to a Medicare Account Manager. No more HR becoming the middleman for complex questions.", image: teamSarah, imageAlt: "Sarah, a smiling customer support representative wearing a headset", tone: "foam" as const, size: "small" as const, imageSide: "right" as const, imageWidth: "15rem" },
  { heading: "Dedicated medicare account team", text: "Non-commissioned agents who act as an extension of your HR department, focused solely on employee outcomes.", image: whyTeam, imageAlt: "Smiling Medicare account manager with long curly blonde hair", tone: "aqua" as const, size: "large" as const, imageSide: "right" as const, imageWidth: "95%" },
  { heading: "Plan analysis & comparison", text: "Personalized reviews of Medicare options based on individual health needs, providers, and prescriptions.", image: whyAnalysis, imageAlt: "Senior man in a grey cardigan reviewing plan options", tone: "brand" as const, size: "large" as const, imageSide: "right" as const, imageWidth: "100%" },
  { heading: "Educational workshops", text: "Live webinars and on-demand resources that prepare employees months before their Medicare eligibility.", image: whyWorkshops, imageAlt: "Man wearing earbuds presenting during a live webinar", tone: "night" as const, size: "small" as const },
  { heading: "Enrollment coordination", text: "We manage the entire transition process—from tracking deadlines to ensuring proper plan selection and enrollment.", image: whyEnrollment, imageAlt: "Two colleagues reviewing enrollment paperwork together", tone: "foam" as const, size: "small" as const },
  { heading: "Ongoing support", text: "Live webinars and on-demand resources thatprepare employees months before their Medicare eligibility.", image: whySupport, imageAlt: "Smiling support specialist wearing a headset", tone: "foam" as const, size: "large" as const, imageSide: "left" as const, imageWidth: "68%", textSide: "right" as const },
];

const myths = [
  { quote: "“employees ALREADY KNOW.”", heading: "Assuming employees will figure it out.", text: "Medicare is getting complex. Without guidance, employees make costly errors that can haunt them for decades." },
  { quote: "“IT CAN WAIT.”", heading: "Waiting until 65 to start the conversation.", text: "Medicare decisions require 3-6 months of preparation. Late starts lead to missed deadlines and rushed choices." },
  { quote: "\"ALL PLANS ARE THE SAME!\"", heading: "Treating all employees the same.", text: "Each employee has unique health needs, prescription requirements, and provider preferences." },
  { quote: "\"ALL PLANS ARE THE SAME!\"", heading: "Relying on HR to be Medicare experts.", text: "HR has enough on their plate. Medicare is a specialized field that demands dedicated expertise and continuous education." },
];

const savings = [
  { icon: iconPremium, heading: "Lower Premium Costs", text: "Medicare Advantage and supplement plans typically cost 40-60% less than continuing group coverage for 65+ employees." },
  { icon: iconPlanSpend, heading: "Reduced Plan Spend", text: "Every employee who transitions to Medicare removes high-cost claims from your group plan, lowering overall premiums for remaining employees" },
  { icon: iconBenefits, heading: "Better Benefits", text: "Employees often receive superior coverage on Medicare with lower out-of-pocket costs, prescription savings, and additional perks like dental and vision." },
];

const articles = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3)
  .map((post) => ({ image: post.data.mainImage, title: post.data.title, slug: post.id }));

const logo = (src: ImageMetadata, alt: string) => ({ kind: "logo" as const, src, alt });
const person = (src: ImageMetadata, alt: string) => ({ kind: "person" as const, src, alt });

const aetna = logo(tickerAetna, "Aetna");
const humana = logo(tickerHumana, "Humana");
const cigna = logo(tickerCigna, "Cigna");
const wellcare = logo(tickerWellcare, "WellCare");
const devoted = logo(tickerDevoted, "Devoted Health");
const anthem = logo(tickerAnthem, "Anthem");
const heartland = logo(tickerHeartland, "Heartland National");
const ashley = person(teamAshley, "Ashley from the Exact Benefits team");
const ricky = person(teamRicky, "Ricky from the Exact Benefits team");
const matt = person(teamMatt, "Matt Buchan from the Exact Benefits team");
const courtney = person(teamCourtney, "Courtney from the Exact Benefits team");

const tickerRows = [
  [aetna, ashley, humana, ricky, cigna, ashley, wellcare, matt, devoted, courtney, anthem, ricky],
  [humana, ashley, aetna, ricky, anthem, ashley, wellcare, matt, heartland, courtney, cigna, ricky],
  [anthem, ashley, heartland, ricky, devoted, ashley, humana, ricky, devoted, ashley, anthem, ricky],
];

const faqs = [
  { q: "What happens if an employee delays Medicare?", a: "If an eligible employee delays Medicare, your group plan usually becomes the primary payer until they enroll. This can increase your plan’s cost exposure and may lead to higher premiums. We help you review each employee’s situation to make sure the timing is right and no one loses coverage or pays penalties." },
  { q: "Does this cost the employer anything?", a: "There’s no added fee for working with Exact Benefits. In many cases, employers actually save money because Medicare becomes the primary payer for eligible employees, reducing claims on your group plan. Our advisors guide you through the process so you stay compliant and financially protected." },
  { q: "What if we’re a small group and Medicare pays first?", a: "For groups under 20 employees, Medicare <strong>usually</strong> becomes the primary payer. That means your group plan acts as secondary coverage. We help you structure coverage correctly, avoid compliance issues, and make sure your employees understand how their benefits work so there are no surprises." },
];
const schema = "{\n  \"@context\": \"https://schema.org\",\n  \"@graph\": [\n    {\n      \"@type\": \"Organization\",\n      \"@id\": \"https://www.exactbenefits.com/#organization\",\n      \"name\": \"Exact Benefits Powered by Exact Medicare\",\n      \"url\": \"https://www.exactbenefits.com/\",\n      \"telephone\": \"+1-888-893-9553\"\n    },\n    {\n      \"@type\": \"Service\",\n      \"@id\": \"https://www.exactbenefits.com/#service\",\n      \"name\": \"Employer Medicare Benefits & Transition Support\",\n      \"serviceType\": \"Employer Medicare Benefits Consulting\",\n      \"description\": \"Exact Benefits helps employers provide trusted Medicare guidance for eligible employees, reduce healthcare costs, remove the Medicare burden from HR teams, coordinate Medicare enrollment, educate employees, and provide ongoing Medicare support at no cost to employers.\",\n      \"provider\": {\n        \"@id\": \"https://www.exactbenefits.com/#organization\"\n      },\n      \"url\": \"https://www.exactbenefits.com/\",\n      \"audience\": {\n        \"@type\": \"Audience\",\n        \"audienceType\": \"Employers, HR teams, CFOs, and business leadership\"\n      },\n      \"offers\": {\n        \"@type\": \"Offer\",\n        \"url\": \"https://www.exactbenefits.com/\",\n        \"priceSpecification\": {\n          \"@type\": \"PriceSpecification\",\n          \"price\": \"0\",\n          \"priceCurrency\": \"USD\",\n          \"description\": \"Schedule a free consultation with an Exact Benefits advisor.\"\n        }\n      }\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"@id\": \"https://www.exactbenefits.com/#faq\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What happens if an employee delays Medicare?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"If an eligible employee delays Medicare, your group plan usually becomes the primary payer until they enroll. This can increase your plan's cost exposure and may lead to higher premiums. Exact Benefits helps review each employee's situation to ensure proper timing and avoid coverage gaps or penalties.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Does this cost the employer anything?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"There is no added fee for working with Exact Benefits. In many cases, employers save money because Medicare becomes the primary payer for eligible employees, reducing claims on the group health plan while advisors help maintain compliance.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"What if we're a small group and Medicare pays first?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"For groups with fewer than 20 employees, Medicare usually becomes the primary payer while the employer group plan serves as secondary coverage. Exact Benefits helps structure coverage correctly, avoid compliance issues, and educate employees about how their benefits work.\"\n          }\n        }\n      ]\n    }\n  ]\n}";
---

<Layout title="Employer Medicare Benefits & Transition Support">
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={schema} /></Fragment>

  <!-- hero -->
  <HeroHome>
    <Eyebrow variant="tag">Employer Medicare Savings</Eyebrow>
    <Heading tag="h1">Medicare Support <br /><em>for Employers</em></Heading>
    <Paragraph variant="large" maxWidth={34}>
      Give employees trusted Medicare guidance, lower healthcare costs, and
      remove the burden from HR—<strong>all at absolutely no cost to the employer.</strong>
    </Paragraph>
    <ButtonWrapper>
      <Button element="link" size="large" href="/#call-anchor">schedule my onboarding call</Button>
    </ButtonWrapper>
  </HeroHome>

  <!-- partners -->
  <CarrierLogos />

  <!-- significant savings -->
  <Section>
    <ContentWrapper variant="columns">
      <Card
        variant="stat"
        theme="brand"
        eyebrow="Average HR savings"
        eyebrowIcon={iconPiggyBank}
        stat="$7,000+"
        statCaption="per employee, per year."
        text="Many employers reinvest those savings directly back into their workforce: meaning better candidates for your team."
        accent={savingsAccent}
      />
      <Heading slot="column2" tag="h2">Significant savings</Heading>
      <Paragraph slot="column2" variant="large">
        Companies often spend over <strong>$7,000 per employee, per year</strong> on
        group premiums alone. Transitioning eligible employees to Medicare can lead
        to substantial savings while improving coverage and lowering employee out-
        of-pocket costs.
      </Paragraph>
      <ButtonWrapper slot="column2">
        <Button element="link" href="#CALC" emphasis="secondary">Calculate savings</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- comparison -->
  <Section align="center">
    <ContentWrapper centered style="--h3-margin-bottom: var(--space-2);">
      <Heading tag="h2" variant="h3">Are Your Employees Paying More for Less?</Heading>
      <Paragraph variant="large" maxWidth={60}>
        Most employees 65+ stay on the group plan, assuming Medicare is inferior —
        but the data tells a very different story.
      </Paragraph>
    </ContentWrapper>
    <TableComparison
      caption="Typical group plan compared with Medicare Advantage"
      labelHeading="Coverage Feature"
      baseHeading="Typical Group Plan"
      highlightHeading="Medicare Advantage"
      rows={comparison}
      highlightImage={comparisonTexture}
    />
    <ButtonWrapper marginTop="0">
      <Button element="link" size="large" href="/#call-anchor">Schedule a Consultation</Button>
    </ButtonWrapper>
  </Section>

  <!-- why exact -->
  <Section theme="dark" id="about" align="center">
    <ContentWrapper centered>
      <Eyebrow variant="tag-outline">Why Exact?</Eyebrow>
      <Heading tag="h2" maxWidth={20}>The <em>obvious choice</em> for internal HR teams.</Heading>
    </ContentWrapper>
    <BentoWhyExact items={why} />
  </Section>

  <!-- newsletter -->
  <NewsletterSection />

  <!-- medicare is changing -->
  <Section>
    <ContentWrapper variant="sticky-stack">
      <Heading tag="h2">Medicare is changing.</Heading>
      <Paragraph maxWidth={40}>
        Most HR teams we see simply aren’t aware of the advantages they could be
        receiving if they qualify.
      </Paragraph>
      <Paragraph><strong>Do any of these sound familiar?</strong></Paragraph>
      <ButtonWrapper>
        <Button element="link" variant="link" href="/#call-anchor">Schedule My Free Call</Button>
      </ButtonWrapper>
      <Fragment slot="column2">
        {myths.map((m) => (
          <Card raised eyebrow={m.quote} eyebrowIcon={iconXCircle} heading={m.heading} headingVariant="h4" text={m.text} headingTag="h3" />
        ))}
      </Fragment>
    </ContentWrapper>
  </Section>

  <!-- save per employee -->
  <Section id="CALC">
    <ContentWrapper variant="columns">
      <Heading tag="h2">Save $7,300 per employee. <br /><em>Each year</em>.</Heading>
      <Paragraph variant="large">
        Helping employees transition to Medicare delivers immediate, measurable
        financial impact for your organization.
      </Paragraph>
      <Grid xsmall={1} class="margin-top-6">
        {savings.map((s) => (
          <ContentWrapper>
            <Img src={s.icon} alt="" variant="densities" width={48} transparent />
            <Heading tag="h3" variant="h5">{s.heading}</Heading>
            <Paragraph>{s.text}</Paragraph>
          </ContentWrapper>
        ))}
      </Grid>
      <CalculatorSavings slot="column2" savingsPerEmployee={7300} />
    </ContentWrapper>
  </Section>

  <!-- partnerships -->
  <PartnershipsSection />

  <!-- featured articles -->
  <Section>
    <Heading tag="h2" variant="h3">Featured Articles &amp; Resources</Heading>
    <Grid medium={3}>
      {articles.map((a) => (
        <Card
          variant="stacked"
          image={a.image}
          heading={a.title}
          buttonLabel="Read More"
          buttonHref={`/blog/${a.slug}`}
        />
      ))}
    </Grid>
  </Section>

  <!-- ticker -->
  <Section theme="dark">
    <ContentWrapper variant="contain" cardTheme="light" column1Class="padding-1">
      <Marquee label="Our carrier partners and team" showcase={tickerRows[0]} controls={false} />
      <Marquee label="More of our carrier partners and team" showcase={tickerRows[1]} direction="backwards" controls={false} />
      <Marquee label="Our carrier partners and advisors" showcase={tickerRows[2]} controls={false} />
      <Heading slot="column2" tag="h2" variant="h3" maxWidth={24}>
        Connect with our team to simplify your Medicare complexity.
      </Heading>
      <ButtonWrapper slot="column2">
        <Button element="link" size="large" href="/#call-anchor">schedule my call</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- faq -->
  <FaqSection tag="FAQ's" heading="We’ve got the answers." items={faqs} />

  <!-- contact -->
  <ContactSection />
</Layout>
